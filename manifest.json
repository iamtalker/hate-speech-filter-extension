{
  "manifest_version": 3,
  "name": "혐오표현 필터",
  "version": "1.10.1",
  "description": "지역/성별/인종 등에 대한 혐오·비하 표현이 포함된 글을 감지해 블러 처리하거나 완전히 숨깁니다. 중립적인 지역명·집단명 자체는 차단하지 않습니다.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hate-speech-filter@iamtalker.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["wordlists.js", "settings-utils.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["wordlists.js", "settings-utils.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
